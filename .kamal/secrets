# Secrets are pulled from the "fathom" 1Password vault via the op CLI. Nothing
# here is a credential, so this file stays safe to commit.
#
# Requires: 1Password desktop unlocked, Settings -> Developer -> "Integrate
# with 1Password CLI" enabled.

# Never check config/master.key into git.
RAILS_MASTER_KEY=$(cat config/master.key)

# Keep this password alphanumeric: it is interpolated into DATABASE_URL below,
# where characters like @ : / ? # would need percent-encoding to parse.
POSTGRES_PASSWORD=$(op read "op://fathom/Production Keys/POSTGRES_PASSWORD")

# "fathom-db" is the accessory's hostname on Kamal's Docker network. The cache,
# queue and cable databases are derived from this URL in config/database.yml.
# The port is explicit: config/database.yml defaults POSTGRES_PORT to 5433
# for docker-compose, and a URL without a port lets that default through.
DATABASE_URL="postgres://fathom:${POSTGRES_PASSWORD}@fathom-db:5432/fathom_production"
CACHE_DATABASE_URL="postgres://fathom:${POSTGRES_PASSWORD}@fathom-db:5432/fathom_production_cache"
QUEUE_DATABASE_URL="postgres://fathom:${POSTGRES_PASSWORD}@fathom-db:5432/fathom_production_queue"
CABLE_DATABASE_URL="postgres://fathom:${POSTGRES_PASSWORD}@fathom-db:5432/fathom_production_cable"

OPENAI_API_KEY=$(op read "op://fathom/Production Keys/OPENAI_API_KEY")
OPENROUTER_API_KEY=$(op read "op://fathom/Production Keys/OPENROUTER_API_KEY")
FIRECRAWL_API_KEY=$(op read "op://fathom/Production Keys/FIRECRAWL_API_KEY")

# The shared password in front of the internal app. Both halves live here
# rather than only the password: a known username halves the work of guessing
# the pair, and it costs nothing to keep it out of a committed file.
FATHOM_USERNAME=$(op read "op://fathom/Production Keys/FATHOM_USERNAME")
FATHOM_PASSWORD=$(op read "op://fathom/Production Keys/FATHOM_PASSWORD")
