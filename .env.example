# Application mode
# fake  -- deterministic adapters, zero external requests (default, used by CI)
# local -- locally hosted models/crawlers, never required for development
# live  -- real external providers, additionally gated by ENABLE_LIVE_AI
APP_MODE=fake
ENABLE_LIVE_AI=false

# AI provider
# AI_PROVIDER accepts any provider RubyLLM ships: openai, anthropic, gemini,
# openrouter, deepseek, mistral, ollama, bedrock, vertexai, xai and others.
OPENAI_API_KEY=
AI_PROVIDER=openai

# Routing chat and analysis through OpenRouter while embeddings stay on OpenAI:
#
#   AI_PROVIDER=openrouter
#   OPENROUTER_API_KEY=sk-or-...
#   AI_EMBEDDING_PROVIDER=openai
#   AI_ANALYSIS_MODEL=anthropic/claude-sonnet-4.5
#   AI_FAST_MODEL=openai/gpt-5-mini
#
# Leave AI_EMBEDDING_PROVIDER pointing at whichever provider produced the
# vectors already in the database. Changing the embedding model or provider
# puts new vectors in a different space from the stored ones, and every scan
# has to be re-indexed before retrieval means anything again.
OPENROUTER_API_KEY=
AI_EMBEDDING_PROVIDER=

# Model routing (configuration, not secrets)
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_FAST_MODEL=gpt-5.6-luna
AI_ANALYSIS_MODEL=gpt-5.6-terra
AI_CHAT_MODEL=gpt-5.6-terra

# How many provider calls one stage may have in flight. A provider meters per
# minute, so the sustainable number is the limit times the call duration: at
# OpenRouter's new-account ceiling of 20 requests per minute and roughly 12
# seconds per analysis call, that is 20 * 12 / 60 = 4. Three leaves headroom for
# the embedding and retrieval calls each answer also makes.
#
# Raise it once the account's rate limit rises. Calls that do hit the limit are
# retried with backoff rather than failing the scan, but waiting is slower than
# not being throttled in the first place.
AI_CALL_CONCURRENCY=3

# The account's per-minute ceiling for a chat model. AI::Client spaces every
# call to fit it, because this is not something concurrency can respect: at 20
# requests a minute and a 2.5 second call, even one sequential stream runs at 24
# a minute. Raise it when the provider raises your limit; 0 disables pacing.
AI_REQUESTS_PER_MINUTE=20

# Crawling
FIRECRAWL_API_KEY=

# Safety
MAX_SCAN_AI_COST_USD=3.00
MAX_DAILY_AI_COST_USD=10.00

# What one crawler API request costs on your plan. The crawler meters credits
# against an account rather than pricing a response, so the per-scan figure is
# counted and multiplied by this. Default: Firecrawl's standard rate.
CRAWL_COST_PER_REQUEST_USD=0.001

MAX_SCAN_PAGES=5000

# PostgreSQL (docker-compose.yml provides these defaults)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=fathom
POSTGRES_PASSWORD=fathom
POSTGRES_DATABASE=fathom_development

# Rails / DB if required by the deployment
DATABASE_URL=
RAILS_MASTER_KEY=

# Access
# The shared password in front of the internal app. With these unset the app
# answers only local requests in development; anything else is refused.
FATHOM_USERNAME=fathom
FATHOM_PASSWORD=change-me
